version: 2
ethernets:
  {{ .InterfaceName }}:
    addresses:
      - {{ .IPAddress }}/{{ .CIDR }}
    gateway4: {{ .Gateway }}
    nameservers:
      addresses:
        {{- range .DNS }}
        - {{ . }}
        {{- end }}
    dhcp4: false
    dhcp6: false
{{- range $i, $nic := .ExtraNICs }}
  extra{{ $i }}:
    match:
      macaddress: "{{ $nic.MACAddress }}"
    optional: true
    addresses:
      - {{ $nic.IPAddress }}/{{ $nic.CIDR }}
    dhcp4: false
    dhcp6: false
{{- end }}
