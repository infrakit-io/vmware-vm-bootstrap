# Generated by vmbootstrap (profile alma). Directives follow the Anaconda kickstart
# reference (docs/almalinux-official/kickstart-docs.txt).
text
poweroff
lang en_US.UTF-8
keyboard --vckeymap=us --xlayouts='us'
timezone Europe/Bucharest --utc
network --bootproto=static --device=00:50:56:aa:bb:cc --ip=10.0.0.10 --netmask=255.255.255.0 --gateway=10.0.0.1 --nameserver=10.0.0.2,1.1.1.1 --hostname=da1 --onboot=yes --activate
url --url="https://repo.example/9.8/BaseOS/x86_64/os/"
repo --name=AppStream --baseurl="https://repo.example/9.8/AppStream/x86_64/os/"
rootpw --lock
user --name=deploy --groups=wheel --iscrypted --password=$2b$10$abcdefghijklmnopqrstuuABCDEFGHIJKLMNOPQRSTUVWXYZ012345
sshkey --username=deploy "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexample admin@mgmt"
firewall --enabled --ssh
selinux --enforcing
services --enabled=sshd,vmtoolsd
firstboot --disable

ignoredisk --only-use=sda
zerombr
clearpart --all --initlabel --drives=sda
bootloader --location=mbr --boot-drive=sda
reqpart
part /boot --fstype=ext4 --size=1024 --ondisk=sda
part / --fstype=ext4 --grow --size=1024 --ondisk=sda

%packages
@^minimal-environment
open-vm-tools
sudo
%end

%post --log=/root/ks-post.log
cat > /etc/ssh/sshd_config.d/01-vmbootstrap.conf <<'EOF'
PasswordAuthentication yes
EOF
chmod 600 /etc/ssh/sshd_config.d/01-vmbootstrap.conf
echo 'deploy ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-vmbootstrap
chmod 440 /etc/sudoers.d/90-vmbootstrap
%end
