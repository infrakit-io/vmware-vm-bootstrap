# Generated by vmbootstrap (profile alma). Directives follow the Anaconda kickstart
# reference (docs/almalinux-official/kickstart-docs.txt).
text
poweroff
lang {{ .Locale }}
keyboard --vckeymap={{ .KeyboardLayout }} --xlayouts='{{ .KeyboardLayout }}'
timezone {{ .Timezone }} --utc
network --bootproto=static --device={{ .Device }} --ip={{ .IPAddress }} --netmask={{ .Netmask }} --gateway={{ .Gateway }} --nameserver={{ .Nameservers }} --hostname={{ .Hostname }} --onboot=yes --activate
url --url="{{ .BaseOSURL }}"
repo --name=AppStream --baseurl="{{ .AppStreamURL }}"
{{ .RootAuth }}
{{- if .User }}
user --name={{ .Username }} --groups={{ .UserGroups }} {{ .UserAuth }}
{{- end }}
{{- range .SSHPublicKeys }}
sshkey --username={{ $.Username }} "{{ . }}"
{{- end }}
firewall --enabled --ssh
selinux --enforcing
services --enabled=sshd,vmtoolsd
firstboot --disable

ignoredisk --only-use={{ .Disks }}
zerombr
clearpart --all --initlabel --drives={{ .Disks }}
bootloader --location=mbr --boot-drive=sda
reqpart
part /boot --fstype={{ .Filesystem }} --size={{ .BootSizeMB }} --ondisk=sda
{{- if gt .SwapSizeGB 0 }}
part swap --size={{ .SwapSizeMB }} --ondisk=sda
{{- end }}
part / --fstype={{ .Filesystem }} --grow --size=1024 --ondisk=sda{{ .RootFSOptions }}
{{- if .DataDiskMountPath }}
part {{ .DataDiskMountPath }} --fstype={{ .Filesystem }} --grow --size=1024 --ondisk=sdb{{ .DataFSOptions }}
{{- end }}

%packages
@^minimal-environment
{{- range .Packages }}
{{ . }}
{{- end }}
%end

%post --log=/root/ks-post.log
cat > /etc/ssh/sshd_config.d/01-vmbootstrap.conf <<'EOF'
PasswordAuthentication {{ if .AllowPasswordSSH }}yes{{ else }}no{{ end }}
EOF
chmod 600 /etc/ssh/sshd_config.d/01-vmbootstrap.conf
{{- if .User }}
echo '{{ .Username }} ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-vmbootstrap
chmod 440 /etc/sudoers.d/90-vmbootstrap
{{- end }}
%end
